<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AvaloniaVersion>11.0.6</AvaloniaVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <BaseOutputPath>$(MSBuildThisFileDirectory)0\$(MSBuildProjectName)\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)0\$(MSBuildProjectName)\obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
